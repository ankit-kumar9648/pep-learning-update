## Q4. Swap Two Numbers

```cpp
#include <iostream>
using namespace std;

int main() {
    int a, b, temp;

    cout << "Enter two numbers: ";
    cin >> a >> b;

    temp = a;
    a = b;
    b = temp;

    cout << "After Swapping:\n";
    cout << "a = " << a << endl;
    cout << "b = " << b;

    return 0;
}
```

